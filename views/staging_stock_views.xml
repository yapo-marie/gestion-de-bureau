<odoo>
    <record id="view_staging_stock_tree" model="ir.ui.view">
        <field name="name">staging.stock.tree</field>
        <field name="model">staging.stock</field>
        <field name="arch" type="xml">
            <tree string="État des Stocks" editable="bottom">
                <header>
                    <button name="action_validate_and_transfer"
                            string="Valider et Transférer vers Odoo"
                            type="object"
                            class="oe_highlight"
                            confirm="Voulez-vous vraiment créer les articles et initialiser les stocks ?"/>
                </header>
                <field name="categorie"/>
                <field name="ref"/>
                <field name="article"/>
                <field name="stock_initial"/>
                <field name="entrees"/>
                <field name="sorties"/>
                <field name="stock_final"/>
                <field name="state" readonly="1"/>
            </tree>
        </field>
    </record>
</odoo>
