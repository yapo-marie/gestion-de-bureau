<odoo>
    <record id="view_staging_article_tree" model="ir.ui.view">
        <field name="name">staging.article.tree</field>
        <field name="model">staging.article</field>
        <field name="arch" type="xml">
            <tree string="Base Articles" editable="bottom" decoration-info="state == 'draft'" decoration-success="state == 'done'">
                <field name="ref"/>
                <field name="designation"/>
                <field name="prix_unitaire"/>
                <field name="state" readonly="1"/>
            </tree>
        </field>
    </record>

    <record id="action_staging_article" model="ir.actions.act_window">
        <field name="name">Articles (Feuille 1)</field>
        <field name="res_model">staging.article</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
